+// Package redpandaforward lets packages outside connect build the redpanda
+// input. Only packages inside connect can import internal/impl/kafka.
+package redpandaforward
+
+import (
+	"github.com/redpanda-data/benthos/v4/public/service"
+
+	"github.com/redpanda-data/connect/v4/internal/impl/kafka"
+)
+
+// ConfigFields returns the redpanda input's config fields plus key_pattern.
+func ConfigFields() []*service.ConfigField {
+	return append(kafka.RedpandaInputConfigFields(), kafka.FranzReaderOrderedKeyPatternField())
+}
+
+// NewRedpandaInput builds a redpanda input with connect's own constructor.
+// A caller that sets key_pattern must drop the empty placeholder messages it
+// produces.
+func NewRedpandaInput(conf *service.ParsedConfig, res *service.Resources) (service.BatchInput, error) {
+	return kafka.NewRedpandaInputFromConfig(conf, res)
+}
