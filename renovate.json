{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "commitMessagePrefix": "[renovate]chore(deps):",
  "enabledManagers": ["dockerfile", "gomod", "github-actions", "custom.regex"],
  "labels": ["dependencies", "skip-changelog-guard"],
  "postUpdateOptions": ["gomodTidy", "gomodUpdateImportPaths"],
  "minimumReleaseAge": "7 days",
  "timezone": "Europe/Berlin",
  "schedule": ["* * * * 0"],
  "separateMajorMinor": false,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track the go directive in go.mod as the golang Docker image, so it gets the same version as the Dockerfile",
      "managerFilePatterns": ["/(^|/)go\\.mod$/"],
      "matchStrings": ["\\ngo (?<currentValue>\\d+\\.\\d+\\.\\d+)\\n"],
      "depNameTemplate": "golang",
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pinDigest"],
      "enabled": false
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["major"],
      "groupName": "github-actions major updates",
      "enabled": true
    },
    {
      "matchManagers": ["gomod", "dockerfile", "custom.regex"],
      "groupName": "All dependencies",
      "groupSlug": "all-deps"
    },
    {
      "description": "The go directive is updated by the custom manager above, from the same source as the Dockerfile",
      "matchDepNames": ["go"],
      "matchManagers": ["gomod"],
      "enabled": false
    },
    {
      "description": "Dependencies can force go mod tidy to raise the go directive to the newest Go release. The golang image must never lag behind it, so it gets no release age delay.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["golang"],
      "minimumReleaseAge": "0 days"
    },
    {
      "description": "Pin gosnowflake to v1 - v2 is a breaking major requiring code changes",
      "matchDepNames": ["github.com/snowflakedb/gosnowflake"],
      "allowedVersions": "<2.0.0"
    },
    {
      "matchPackagePatterns": ["^github\\.com/RuneRoven/go-ads/v2"],
      "enabled": false
    }
  ]
}
